+/** Dose máxima em mg: mg/kg × peso, sem passar do teto absoluto quando ele existe. */
+function doseMaxima(a: AnestheticCalc, peso: number, comEpi: boolean): number {
+  const mg = peso * (comEpi ? a.withEpi : a.noEpi)
+  const teto = comEpi ? a.withEpiMax : a.noEpiMax
+  return teto !== undefined ? Math.min(mg, teto) : mg
+}
