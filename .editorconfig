# Coerente com o .prettierrc: 2 espaços, LF, linha de até 100 colunas.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,cjs,json}]
max_line_length = 100

# Dois espaços no fim da linha são quebra de linha no Markdown (cabeçalhos das ADRs).
[*.md]
trim_trailing_whitespace = false
