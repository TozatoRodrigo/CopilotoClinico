generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EncounterStatus {
  draft
  in_review
  finalized
  cancelled
}

enum DocumentType {
  soap
  sbar
  prescricao
  alta
  atestado
}

enum SubscriptionStatus {
  active
  inactive
  trial
}

enum ProtocolStatus {
  draft
  published
  retired
}

enum ProtocolNodeType {
  question
  action
  outcome
}

enum GuidelineChunkStatus {
  pending_review
  approved
  rejected
  superseded
  /// ADR-010 — documento oficial do MS (Conitec) ingerido sem revisão da
  /// equipe clínica. Nunca é tratado como `approved`.
  official_unreviewed
}

/// ADR-010 — listas publicadas pela Conitec.
enum OfficialGuidelineKind {
  pcdt
  ddt
  diretriz_brasileira
  protocolo_uso
}

enum OfficialDocumentStatus {
  active
  superseded
}

/// ADR-010 — contexto de uso predominante do documento, usado para ponderar o
/// retrieval (documento crônico em caso agudo).
enum CareSetting {
  agudo
  cronico
  misto
  indefinido
}

enum InstitutionStatus {
  active
  inactive
}

enum Role {
  PHYSICIAN
  COMPLIANCE
  ADMIN
}

/// F0-D — o que o médico fez com UMA recomendação. `modified` = adotou com
/// ajuste (Adotar + nota); ver use-recommendation-decisions.ts no web.
enum RecommendationDecisionKind {
  adopted
  rejected
  modified
}

/// F7 — o que o médico reportou sobre uma análise (mesmos valores de
/// `feedbackKindValues` em copilot.schemas.ts).
enum CopilotFeedbackKind {
  wrong_scenario
  missing_coverage
  wrong_recommendation
  helpful
}

/// F0-D — estado do reporte na fila de triagem da curadoria.
enum CopilotFeedbackStatus {
  new
  triaged
  converted_to_eval_case
  dismissed
}

/// CC-707 — estado do pedido de mentoria. As transições válidas estão em
/// src/modules/mentoring/mentoring-transitions.ts.
enum MentoringRequestStatus {
  pending
  claimed
  answered
  cancelled
}

model Physician {
  id                 String             @id @default(uuid()) @db.Uuid
  crmUf              String             @map("crm_uf") @db.Char(2)
  crmNumber          String             @map("crm_number")
  email              String             @unique @db.VarChar(255)
  passwordHash       String             @map("password_hash")
  name               String?            @db.VarChar(255)
  crmVerified        Boolean            @default(false) @map("crm_verified")
  mfaEnabled         Boolean            @default(false) @map("mfa_enabled")
  mfaSecret          String?            @map("mfa_secret") @db.Text
  subscriptionStatus SubscriptionStatus @default(trial) @map("subscription_status")
  role               Role               @default(PHYSICIAN)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  isCurator Boolean   @default(false) @map("is_curator")
  // PI-05 — preferência de idioma persistida na conta (não só localStorage
  // do dispositivo): o médico troca de terminal no hospital e a UI/análise
  // precisam seguir com ele. 'pt-BR' | 'es' — validado na aplicação, não
  // como enum do banco, para não exigir migração a cada novo idioma.
  locale    String    @default("pt-BR")
  // CC-018 — quando a eliminação LGPD anonimizou o cadastro. A estratégia JWT
  // e o refresh recusam sessão de quem tem esta data: o access token é
  // stateless e, sem isso, seguia valendo até expirar (15 min).
  erasedAt  DateTime? @map("erased_at")
  // CC-014 — slug de physicianSpecialtyValues (src/shared/contracts/clinical.ts),
  // validado na aplicação pelo mesmo motivo do locale. Nulo até o médico escolher.
  specialty String?   @db.VarChar(64)
  // CC-707 — médico da equipe que responde pedidos de mentoria. Flag
  // operacional, como `isCurator`: ligada por SQL (ver docs/runbook.md).
  isMentor  Boolean   @default(false) @map("is_mentor")

  encounters              Encounter[]
  documents               Document[]
  consents                Consent[]
  betaParticipant         BetaParticipant?
  refreshTokens           RefreshToken[]
  mfaBackupCodes          MfaBackupCode[]
  crmVerificationRequests CrmVerificationRequest[]
  institutions            PhysicianInstitution[]
  recommendationDecisions RecommendationDecision[]
  copilotFeedback         CopilotFeedback[]
  practiceSites           PracticeSite[]
  mentoringRequests       MentoringRequest[]       @relation("MentoringRequester")
  mentoringAnswers        MentoringRequest[]       @relation("MentoringMentor")

  @@map("physicians")
}

/// CC-602 — local onde o médico dá plantão: recursos (TC, laboratório, UTI),
/// porte do serviço, especialistas e distância até a referência. Preenche o
/// contexto do caso novo; o médico troca no caso. Sem dado de paciente.
///
/// Um padrão por médico: garantido pelo índice único parcial
/// `practice_sites_one_default_per_physician` (só na migration — o Prisma não
/// descreve índice parcial) e pela transação do serviço.
model PracticeSite {
  id                     String   @id @default(uuid()) @db.Uuid
  physicianId            String   @map("physician_id") @db.Uuid
  name                   String   @db.VarChar(80)
  /// FacilityType (src/shared/contracts/practice-site.ts), validado na aplicação.
  facilityType           String   @map("facility_type") @db.VarChar(32)
  hasCT                  Boolean  @default(false) @map("has_ct")
  hasLab                 Boolean  @default(false) @map("has_lab")
  hasICU                 Boolean  @default(false) @map("has_icu")
  isSus                  Boolean  @default(false) @map("is_sus")
  /// SiteSpecialist[], validado na aplicação.
  specialists            String[] @default([])
  referenceTravelMinutes Int?     @map("reference_travel_minutes")
  referenceDistanceKm    Int?     @map("reference_distance_km")
  isDefault              Boolean  @default(false) @map("is_default")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([physicianId])
  @@map("practice_sites")
}

/**
 * PROT-004: instituição de saúde (hospital/rede). Médico pode pertencer a N
 * instituições (plantonista é multivínculo por natureza) via
 * PhysicianInstitution. institutionId em GuidelineChunk/Encounter/Protocol é
 * nullable — NULL representa conteúdo/atendimento global, visível a todas as
 * instituições.
 * CC-021: por isso essas três FKs são `onDelete: Restrict`. Com SetNull, apagar
 * a instituição tornava global o protocolo e a diretriz internos dela. Para
 * tirar uma instituição de uso, desative (`status = inactive`); ver ADR-009.
 */
model Institution {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  cnes      String?           @db.VarChar(20)
  status    InstitutionStatus @default(active)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  physicians      PhysicianInstitution[]
  guidelineChunks GuidelineChunk[]
  encounters      Encounter[]
  protocols       Protocol[]

  mentoringRequests MentoringRequest[]

  @@map("institutions")
}

model PhysicianInstitution {
  id            String   @id @default(uuid()) @db.Uuid
  physicianId   String   @map("physician_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  physician   Physician   @relation(fields: [physicianId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([physicianId, institutionId])
  @@index([institutionId])
  @@map("physician_institutions")
}

enum CrmVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model LoginSecurityState {
  id             String    @id @default(uuid()) @db.Uuid
  identifierHash String    @unique @map("identifier_hash") @db.Char(64)
  physicianId    String?   @map("physician_id") @db.Uuid
  failedCount    Int       @default(0) @map("failed_count")
  lockedUntil    DateTime? @map("locked_until")
  lastFailedAt   DateTime? @map("last_failed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([lockedUntil])
  @@map("login_security_states")
}

model Encounter {
  id             String          @id @default(uuid()) @db.Uuid
  physicianId    String          @map("physician_id") @db.Uuid
  institutionId  String?         @map("institution_id") @db.Uuid
  vertical       String          @default("trauma")
  context        Json?
  // S25-QC-01 — opcional: sem identificação, o encontro é uma "consulta
  // rápida" (não aparece na fila do Plantão até o médico identificar o
  // paciente via PATCH). Ver EncountersService.findByPhysician.
  patientRef     String?         @map("patient_ref") @db.VarChar(50)
  // RD-E7 — queixa principal derivada da 1ª análise de IA (nunca digitada
  // manualmente); título das listas de casos no lugar de patientRef. Até 140
  // caracteres na aplicação; TEXT porque o valor cifrado (CC-207) é maior.
  chiefComplaint String?         @map("chief_complaint") @db.Text
  status         EncounterStatus @default(draft)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  physician      Physician             @relation(fields: [physicianId], references: [id], onDelete: Cascade)
  institution    Institution?          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  aiInteractions AiInteraction[]
  documents      Document[]
  audioCaptures  AudioCapture[]
  protocolRuns   ProtocolRun[]
  attachments    EncounterAttachment[]

  recommendationDecisions RecommendationDecision[]
  copilotFeedback         CopilotFeedback[]
  caseIntakes             CaseIntake[]
  mentoringRequests       MentoringRequest[]

  @@index([physicianId])
  @@index([institutionId])
  @@map("encounters")
}

/// F4 — Referência anexada pelo médico a UM atendimento.
///
/// Origem: um médico do piloto viu um caso de dengue ser conduzido como sepse
/// e quis anexar a diretriz da ABRAMEDE àquele caso. Isso é diferente de
/// sugerir para a base global (POST /guidelines/suggest): vale só para este
/// atendimento, não passa por curadoria e não afeta nenhum outro médico.
///
/// Guarda o TEXTO JÁ REDIGIDO (PII mascarada), nunca o arquivo original —
/// minimização LGPD. Depois da extração o binário não tem mais utilidade, e
/// guardá-lo só aumentaria a superfície de dados sensíveis em repouso.
model EncounterAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  encounterId String   @map("encounter_id") @db.Uuid
  physicianId String   @map("physician_id") @db.Uuid
  filename    String   @db.VarChar(300)
  mimeType    String   @map("mime_type") @db.VarChar(120)
  sizeBytes   Int      @map("size_bytes")
  /// Texto extraído e já mascarado de PII. Untrusted: nunca entra no prompt
  /// como fonte curada — ver prompt-builder.ts, bloco physician_attachments.
  text        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@map("encounter_attachments")
}

model AiInteraction {
  id                  String   @id @default(uuid()) @db.Uuid
  encounterId         String   @map("encounter_id") @db.Uuid
  inputRedacted       String?  @map("input_redacted") @db.Text
  retrievedChunkIds   String[] @map("retrieved_chunk_ids")
  model               String
  params              Json?
  rawOutput           Json     @map("raw_output")
  citations           Json?
  uncertainty         Boolean  @default(false)
  uncertaintyReason   String?  @map("uncertainty_reason") @db.Text
  latencyMs           Int      @map("latency_ms")
  cost                Float    @default(0)
  turnIndex           Int      @default(0) @map("turn_index")
  parentInteractionId String?  @map("parent_interaction_id") @db.Uuid
  answeredQuestions   Json?    @map("answered_questions")
  /// Requisição que gerou a interação; liga às chamadas de IA em ai_calls.
  requestId           String?  @map("request_id") @db.VarChar(64)
  createdAt           DateTime @default(now()) @map("created_at")

  encounter         Encounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  parentInteraction AiInteraction?  @relation("InteractionThread", fields: [parentInteractionId], references: [id], onDelete: SetNull)
  childInteractions AiInteraction[] @relation("InteractionThread")

  recommendationDecisions RecommendationDecision[]
  copilotFeedback         CopilotFeedback[]
  caseIntake              CaseIntake?
  knowledgeGaps           KnowledgeGap[]
  mentoringRequests       MentoringRequest[]

  @@index([encounterId])
  @@index([parentInteractionId])
  @@index([requestId])
  @@map("ai_interactions")
}

/// Rastro de cada chamada de IA (fase 0 do plano de 13/10/2026): etapa,
/// provedor, modelo, versão do prompt (hash do system prompt), tokens, custo,
/// latência e desfecho. Só metadados: nenhum texto do caso, do prompt ou da
/// resposta. Sem FK de propósito: a gravação não pode falhar a análise, e
/// apagar o atendimento não apaga o custo agregado.
model AiCall {
  id               String   @id @default(uuid()) @db.Uuid
  requestId        String?  @map("request_id") @db.VarChar(64)
  physicianId      String?  @map("physician_id") @db.Uuid
  encounterId      String?  @map("encounter_id") @db.Uuid
  stage            String   @db.VarChar(32)
  profile          String   @db.VarChar(32)
  provider         String   @db.VarChar(16)
  requestedModel   String   @map("requested_model") @db.VarChar(128)
  servedModel      String?  @map("served_model") @db.VarChar(128)
  effort           String?  @db.VarChar(8)
  promptSha256     String   @map("prompt_sha256") @db.Char(64)
  responseSchema   String?  @map("response_schema") @db.VarChar(64)
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  cacheReadTokens  Int?     @map("cache_read_tokens")
  cacheWriteTokens Int?     @map("cache_write_tokens")
  costUsd          Float?   @map("cost_usd")
  latencyMs        Int      @map("latency_ms")
  outcome          String   @db.VarChar(16)
  errorType        String?  @map("error_type") @db.VarChar(64)
  /// CC-107 — perfil que ficou indisponível e que esta chamada, no modelo de reserva, substituiu.
  fallbackFrom     String?  @map("fallback_from") @db.VarChar(32)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([requestId])
  @@index([encounterId, createdAt])
  @@index([createdAt])
  @@map("ai_calls")
}

/// ADR-014 — Copiloto guiado: para onde a leitura do caso mandou a conversa.
enum CaseIntakePath {
  ask
  unstable
  complete
  reading_failed
  disabled
}

enum CaseIntakeStatus {
  asking
  closed
}

enum CaseIntakeCloseReason {
  all_answered
  skipped
  urgent_answer
  not_needed
}

/// ADR-014 — a conversa antes do primeiro plano: o caso como o médico mandou,
/// a leitura do caso, as perguntas (no máximo 3) e as respostas.
///
/// Fica no servidor para o médico interrompido voltar de qualquer aparelho e
/// continuar na pergunta da vez. Texto do caso e respostas são gravados JÁ
/// REDIGIDOS (PII + patientRef), como em `ai_interactions.input_redacted`.
/// A análise que nasce da conversa continua sendo uma `AiInteraction`, ligada
/// aqui por `analysis_interaction_id`: o funil de produto segue contando planos.
model CaseIntake {
  id                    String                 @id @default(uuid()) @db.Uuid
  encounterId           String                 @map("encounter_id") @db.Uuid
  physicianId           String                 @map("physician_id") @db.Uuid
  caseTextRedacted      String                 @map("case_text_redacted") @db.Text
  context               Json
  redFlags              Json                   @map("red_flags")
  demoCase              String?                @map("demo_case") @db.VarChar(64)
  piiDetected           Boolean                @default(false) @map("pii_detected")
  path                  CaseIntakePath
  status                CaseIntakeStatus
  closeReason           CaseIntakeCloseReason? @map("close_reason")
  /// Leitura do caso (entendimento + perguntas candidatas); null sem leitura.
  reading               Json?
  readingModel          String?                @map("reading_model")
  /// IntakeQuestionRecord[] — as perguntas que o portão deixou passar.
  questions             Json
  /// IntakeAnswer[] — respostas já redigidas, na ordem em que vieram.
  answers               Json
  /// Custo e tempo da leitura do caso; os da análise ficam na AiInteraction.
  cost                  Float                  @default(0)
  latencyMs             Int                    @default(0) @map("latency_ms")
  analysisStartedAt     DateTime?              @map("analysis_started_at")
  analysisInteractionId String?                @unique @map("analysis_interaction_id") @db.Uuid
  closedAt              DateTime?              @map("closed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  encounter           Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  analysisInteraction AiInteraction? @relation(fields: [analysisInteractionId], references: [id], onDelete: SetNull)

  @@index([encounterId, createdAt])
  @@map("case_intakes")
}

/// F0-D — decisão do médico sobre UMA recomendação de UMA análise.
///
/// Origem: Adotar/Rejeitar/Anotar viviam só no sessionStorage do navegador —
/// o sinal mais direto de "o copiloto acertou?" morria com a aba do plantão.
///
/// Recomendações não têm id no `rawOutput`. `recommendationKey` é
/// `<índice>-<12 hex do sha256 da ação>`, calculado no SERVIDOR a partir do
/// `rawOutput` gravado (nunca enviado pelo cliente): o índice localiza a
/// recomendação e o hash prova a qual texto a decisão se refere, mesmo que um
/// dia o `rawOutput` seja reprocessado. `recommendationIndex` fica em coluna
/// própria só para facilitar o JOIN com `raw_output->'recommendations'`.
model RecommendationDecision {
  id                  String                     @id @default(uuid()) @db.Uuid
  encounterId         String                     @map("encounter_id") @db.Uuid
  interactionId       String                     @map("interaction_id") @db.Uuid
  physicianId         String                     @map("physician_id") @db.Uuid
  recommendationIndex Int                        @map("recommendation_index")
  recommendationKey   String                     @map("recommendation_key") @db.VarChar(32)
  decision            RecommendationDecisionKind
  /// Já mascarada de PII (maskPII) antes de gravar.
  note                String?                    @db.Text
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  encounter   Encounter     @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  interaction AiInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  physician   Physician     @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@unique([interactionId, recommendationKey, physicianId])
  @@index([encounterId])
  @@index([physicianId])
  @@map("recommendation_decisions")
}

model Document {
  id                 String       @id @default(uuid()) @db.Uuid
  encounterId        String       @map("encounter_id") @db.Uuid
  physicianId        String       @map("physician_id") @db.Uuid
  type               DocumentType
  content            Json
  physicianEdits     Json?        @map("physician_edits")
  confirmedBy        String?      @map("confirmed_by") @db.Uuid
  confirmedAt        DateTime?    @map("confirmed_at")
  pdfObjectKey       String?      @map("pdf_object_key")
  contentHash        String?      @map("content_hash") @db.Char(64)
  /// ADR-018 — algoritmo do content_hash (1 = legado, 2 = JSON canônico).
  /// CHECK no banco: preenchido se e somente se content_hash estiver.
  contentHashVersion Int?         @map("content_hash_version") @db.SmallInt
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([physicianId])
  @@map("documents")
}

/// F0-D — fila de triagem do feedback do médico ("cenário errado", "faltou
/// diretriz", "conduta incorreta", "foi útil").
///
/// Origem: o F7 gravava o reporte só como entrada COPILOT_FEEDBACK na trilha
/// de auditoria — sem fila, sem estado, ninguém triava. Erros clínicos
/// conhecidos continuaram chegando por WhatsApp. A entrada na trilha continua
/// (é o registro médico-legal); esta tabela é a fila de trabalho.
model CopilotFeedback {
  id            String                @id @default(uuid()) @db.Uuid
  interactionId String                @map("interaction_id") @db.Uuid
  encounterId   String                @map("encounter_id") @db.Uuid
  physicianId   String                @map("physician_id") @db.Uuid
  kind          CopilotFeedbackKind
  /// Já mascarado de PII (maskPII) antes de gravar.
  comment       String?               @db.Text
  status        CopilotFeedbackStatus @default(new)
  /// Já mascarada de PII.
  triageNote    String?               @map("triage_note") @db.Text
  /// Curador que mudou o status por último (sem FK, como `reviewedBy`).
  triagedBy     String?               @map("triaged_by") @db.Uuid
  triagedAt     DateTime?             @map("triaged_at")
  /// Entrada COPILOT_FEEDBACK correspondente na trilha. Única: liga a fila ao
  /// registro médico-legal e torna o backfill idempotente.
  auditLogId    String?               @unique @map("audit_log_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")

  encounter   Encounter     @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  interaction AiInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  physician   Physician     @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([encounterId])
  @@index([physicianId])
  @@map("copilot_feedback")
}

/// CC-703 — de onde veio a lacuna. A CC-409 acrescenta a da análise sem cartão
/// aplicável; a CC-501, a da pergunta rápida sem cartão.
enum KnowledgeGapSource {
  /// O médico tocou "não encontrei o que precisava" na análise.
  physician_not_found
}

/// CC-703 — registro de lacunas: o que o médico procurou e o Copiloto não
/// tinha. É a entrada da fila de criação de cartões (CC-409: lacunas mais
/// frequentes da semana) e do painel do beta (CC-705).
///
/// Sem texto do caso: a síndrome de PS e as consultas da busca dirigida vêm
/// do entendimento da análise (`extractUnderstandingSignals`), e a nota é a
/// frase curta do médico, mascarada. Sem `physician_id`: a lacuna é do
/// conteúdo, não de quem a encontrou; apagar o atendimento (LGPD) apaga a
/// análise e, por cascata, a lacuna.
model KnowledgeGap {
  id            String             @id @default(uuid()) @db.Uuid
  source        KnowledgeGapSource
  /// Análise em que a lacuna apareceu; null para fontes sem análise (CC-501).
  interactionId String?            @map("interaction_id") @db.Uuid
  /// `PS_SYNDROMES`; null quando a análise não registrou o entendimento.
  syndrome      String?            @db.VarChar(40)
  /// Consultas da busca dirigida (até 4), mascaradas.
  searchQueries String[]           @map("search_queries")
  /// O que faltou, nas palavras do médico — já mascarado de PII.
  note          String?            @db.Text
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  interaction AiInteraction? @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  /// Uma lacuna por análise e fonte: tocar de novo atualiza a nota em vez de
  /// contar duas vezes. Lacunas sem análise (NULL) não colidem entre si.
  @@unique([interactionId, source])
  @@index([createdAt])
  @@index([syndrome, createdAt])
  @@map("knowledge_gaps")
}

/// CC-707 — "Discutir este caso com um médico da equipe" (mentoria em modo
/// concierge, teleinterconsulta da Res. CFM 2.314/2022).
///
/// Assíncrona, não serve para urgência: o objetivo é medir a demanda antes de
/// construir produto pago. O médico aceita um termo versionado (CC-708) e
/// manda o caso MASCARADO com o plano da IA (`case_snapshot`), nunca dado do
/// paciente; um mentor (`physicians.is_mentor`) assume, responde, e a resposta
/// aparece no próprio caso. Texto livre (pergunta e resposta) é gravado já
/// mascarado.
///
/// `institution_id` é a do caso no momento do pedido (ADR-009): o mentor só
/// enxerga pedidos sem instituição ou de uma instituição a que pertence.
model MentoringRequest {
  id                    String                 @id @default(uuid()) @db.Uuid
  encounterId           String                 @map("encounter_id") @db.Uuid
  requesterId           String                 @map("requester_id") @db.Uuid
  institutionId         String?                @map("institution_id") @db.Uuid
  /// Análise cujo plano foi enviado.
  interactionId         String?                @map("interaction_id") @db.Uuid
  status                MentoringRequestStatus @default(pending)
  /// MentoringCaseSnapshot — o que os mentores recebem, já mascarado.
  caseSnapshot          Json                   @map("case_snapshot")
  /// Pergunta do médico ao mentor, já mascarada.
  question              String?                @db.Text
  termsVersion          String                 @map("terms_version") @db.VarChar(64)
  termsAcceptedAt       DateTime               @map("terms_accepted_at")
  mentorId              String?                @map("mentor_id") @db.Uuid
  claimedAt             DateTime?              @map("claimed_at")
  /// Resposta do mentor, já mascarada.
  answer                String?                @db.Text
  answeredAt            DateTime?              @map("answered_at")
  mentorTermsVersion    String?                @map("mentor_terms_version") @db.VarChar(64)
  mentorTermsAcceptedAt DateTime?              @map("mentor_terms_accepted_at")
  /// Quando o médico abriu a resposta: sem valor, a resposta é "nova" no app.
  answerSeenAt          DateTime?              @map("answer_seen_at")
  cancelledAt           DateTime?              @map("cancelled_at")
  /// Nota de 1 a 5 do médico depois da resposta (CHECK na migration).
  satisfaction          Int?                   @db.SmallInt
  ratedAt               DateTime?              @map("rated_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  encounter   Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  requester   Physician      @relation("MentoringRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  mentor      Physician?     @relation("MentoringMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  /// Restrict (CC-021): com SetNull, apagar a instituição tornaria o pedido
  /// visível a todos os mentores.
  institution Institution?   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  interaction AiInteraction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([encounterId])
  @@index([requesterId])
  @@index([mentorId])
  @@index([institutionId])
  @@index([createdAt])
  @@map("mentoring_requests")
}

model GuidelineChunk {
  id            String                       @id @default(uuid()) @db.Uuid
  source        String
  sourceVersion String                       @map("source_version")
  specialty     String
  evidenceLevel String?                      @map("evidence_level")
  text          String                       @db.Text
  /// F9 — coluna GENERATED ALWAYS AS (to_tsvector('portuguese', text)) STORED,
  /// criada em SQL (20260924180000_f9_guideline_chunks_text_tsv_generated): o
  /// Prisma não modela colunas geradas. Nunca escrever nela.
  textTsv       Unsupported("tsvector")?     @map("text_tsv")
  embedding     Unsupported("vector(1536)")?
  metadata      Json?
  status        GuidelineChunkStatus         @default(pending_review)
  institutionId String?                      @map("institution_id") @db.Uuid
  reviewedBy    String?                      @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?                    @map("reviewed_at")
  /// Motivo da rejeição escrito pelo curador, já mascarado (`maskFreeText`).
  /// A trilha (GUIDELINE_REJECTED) leva só o hash — ver docs/compliance/LGPD.md.
  reviewNote    String?                      @map("review_note") @db.Text
  validFrom     DateTime                     @default(now()) @map("valid_from")
  validTo       DateTime?                    @map("valid_to")
  createdAt     DateTime                     @default(now()) @map("created_at")

  /// ADR-010 — versão do documento oficial de onde o chunk saiu.
  documentId String? @map("document_id") @db.Uuid

  institution Institution?               @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  document    OfficialGuidelineDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([source, sourceVersion])
  @@index([specialty])
  @@index([status])
  @@index([institutionId])
  @@index([documentId])
  @@index([textTsv], type: Gin, map: "guideline_chunks_text_tsv_idx")
  @@map("guideline_chunks")
}

/// ADR-010 — uma VERSÃO de um documento oficial (PCDT/DDT/DB/PU). Uma versão
/// nova (PDF com outro SHA-256) substitui a anterior na mesma transação; o
/// índice parcial da migration garante uma única versão `active` por chave.
model OfficialGuidelineDocument {
  id              String                 @id @default(uuid()) @db.Uuid
  kind            OfficialGuidelineKind
  /// Estável entre versões: `<kind>:<slug do título>`.
  documentKey     String                 @map("document_key")
  title           String
  /// Texto da portaria como publicado na lista da Conitec.
  normativeAct    String?                @map("normative_act")
  publishedAt     DateTime?              @map("published_at") @db.Date
  annexUpdatedAt  DateTime?              @map("annex_updated_at") @db.Date
  documentUrl     String                 @map("document_url")
  normativeActUrl String?                @map("normative_act_url")
  summaryUrl      String?                @map("summary_url")
  pdfSha256       String                 @map("pdf_sha256")
  pageCount       Int?                   @map("page_count")
  cid10           String[]
  /// Seções reconhecidas: `{ number, title, included, chars }[]`.
  sections        Json
  /// `structured` quando a estrutura de seções foi reconhecida; `fallback` quando
  /// o corpo entrou inteiro (até as referências).
  sectioning      String
  careSetting     CareSetting            @default(indefinido) @map("care_setting")
  population      String?
  specialty       String
  cenarios        String[]
  /// Origem e justificativa da classificação: `{ source, model?, rationale }`.
  classification  Json?
  status          OfficialDocumentStatus @default(active)
  chunkCount      Int                    @map("chunk_count")
  fetchedAt       DateTime               @map("fetched_at")
  supersededAt    DateTime?              @map("superseded_at")
  createdAt       DateTime               @default(now()) @map("created_at")

  chunks GuidelineChunk[]

  @@unique([documentKey, pdfSha256])
  @@index([status])
  @@index([kind])
  @@map("official_guideline_documents")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @map("actor_id")
  action      String
  entity      String
  entityId    String   @map("entity_id")
  beforeHash  String?  @map("before_hash") @db.Char(64)
  afterHash   String?  @map("after_hash") @db.Char(64)
  /// ADR-015: NULL = hash legado (ordem de inserção); 2 = JSON canônico.
  hashVersion Int?     @map("hash_version") @db.SmallInt
  payload     Json?
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

