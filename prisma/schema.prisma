generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EncounterStatus {
  draft
  in_review
  finalized
  cancelled
}

enum DocumentType {
  soap
  sbar
  prescricao
  alta
  atestado
}

enum SubscriptionStatus {
  active
  inactive
  trial
}

enum ProtocolStatus {
  draft
  published
  retired
}

enum ProtocolNodeType {
  question
  action
  outcome
}

enum GuidelineChunkStatus {
  pending_review
  approved
  rejected
  superseded
}

enum InstitutionStatus {
  active
  inactive
}

enum Role {
  PHYSICIAN
  COMPLIANCE
  ADMIN
}

model Physician {
  id                 String             @id @default(uuid()) @db.Uuid
  crmUf              String             @map("crm_uf") @db.Char(2)
  crmNumber          String             @map("crm_number")
  email              String             @unique @db.VarChar(255)
  passwordHash       String             @map("password_hash")
  name               String?            @db.VarChar(255)
  crmVerified        Boolean            @default(false) @map("crm_verified")
  mfaEnabled         Boolean            @default(false) @map("mfa_enabled")
  mfaSecret          String?            @map("mfa_secret") @db.Text
  subscriptionStatus SubscriptionStatus @default(trial) @map("subscription_status")
  role               Role               @default(PHYSICIAN)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  isCurator          Boolean            @default(false) @map("is_curator")
  // PI-05 — preferência de idioma persistida na conta (não só localStorage
  // do dispositivo): o médico troca de terminal no hospital e a UI/análise
  // precisam seguir com ele. 'pt-BR' | 'es' — validado na aplicação, não
  // como enum do banco, para não exigir migração a cada novo idioma.
  locale             String             @default("pt-BR")

  encounters            Encounter[]
  documents             Document[]
  consents              Consent[]
  refreshTokens         RefreshToken[]
  mfaBackupCodes        MfaBackupCode[]
  crmVerificationRequests CrmVerificationRequest[]
  institutions          PhysicianInstitution[]

  @@map("physicians")
}

/**
 * PROT-004: instituição de saúde (hospital/rede). Médico pode pertencer a N
 * instituições (plantonista é multivínculo por natureza) via
 * PhysicianInstitution. institutionId em GuidelineChunk/Encounter/Protocol é
 * nullable — NULL representa conteúdo/atendimento global, visível a todas as
 * instituições.
 */
model Institution {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  cnes      String?           @db.VarChar(20)
  status    InstitutionStatus @default(active)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  physicians      PhysicianInstitution[]
  guidelineChunks GuidelineChunk[]
  encounters      Encounter[]
  protocols       Protocol[]

  @@map("institutions")
}

model PhysicianInstitution {
  id            String   @id @default(uuid()) @db.Uuid
  physicianId   String   @map("physician_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  physician   Physician   @relation(fields: [physicianId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([physicianId, institutionId])
  @@index([institutionId])
  @@map("physician_institutions")
}

enum CrmVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model LoginSecurityState {
  id             String    @id @default(uuid()) @db.Uuid
  identifierHash String    @unique @map("identifier_hash") @db.Char(64)
  physicianId    String?   @map("physician_id") @db.Uuid
  failedCount    Int       @default(0) @map("failed_count")
  lockedUntil    DateTime? @map("locked_until")
  lastFailedAt   DateTime? @map("last_failed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([lockedUntil])
  @@map("login_security_states")
}

model Encounter {
  id            String          @id @default(uuid()) @db.Uuid
  physicianId   String          @map("physician_id") @db.Uuid
  institutionId String?         @map("institution_id") @db.Uuid
  vertical      String          @default("trauma")
  context       Json?
  patientRef    String          @map("patient_ref") @db.VarChar(50)
  status        EncounterStatus @default(draft)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  physician       Physician       @relation(fields: [physicianId], references: [id], onDelete: Cascade)
  institution     Institution?    @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  aiInteractions  AiInteraction[]
  documents       Document[]
  audioCaptures   AudioCapture[]
  protocolRuns    ProtocolRun[]

  @@index([physicianId])
  @@index([institutionId])
  @@map("encounters")
}

model AiInteraction {
  id                  String   @id @default(uuid()) @db.Uuid
  encounterId         String   @map("encounter_id") @db.Uuid
  inputRedacted       String?  @map("input_redacted") @db.Text
  retrievedChunkIds   String[] @map("retrieved_chunk_ids")
  model               String
  params              Json?
  rawOutput           Json     @map("raw_output")
  citations           Json?
  uncertainty         Boolean  @default(false)
  uncertaintyReason   String?  @map("uncertainty_reason") @db.Text
  latencyMs           Int      @map("latency_ms")
  cost                Float    @default(0)
  turnIndex           Int      @default(0) @map("turn_index")
  parentInteractionId String?  @map("parent_interaction_id") @db.Uuid
  answeredQuestions   Json?    @map("answered_questions")
  createdAt           DateTime @default(now()) @map("created_at")

  encounter         Encounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  parentInteraction AiInteraction?  @relation("InteractionThread", fields: [parentInteractionId], references: [id], onDelete: SetNull)
  childInteractions AiInteraction[] @relation("InteractionThread")

  @@index([encounterId])
  @@index([parentInteractionId])
  @@map("ai_interactions")
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  encounterId    String       @map("encounter_id") @db.Uuid
  physicianId    String       @map("physician_id") @db.Uuid
  type           DocumentType
  content        Json
  physicianEdits Json?        @map("physician_edits")
  confirmedBy    String?      @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime?    @map("confirmed_at")
  pdfObjectKey   String?      @map("pdf_object_key")
  contentHash    String?      @map("content_hash") @db.Char(64)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([physicianId])
  @@map("documents")
}

model GuidelineChunk {
  id            String               @id @default(uuid()) @db.Uuid
  source        String
  sourceVersion String               @map("source_version")
  specialty     String
  evidenceLevel String?              @map("evidence_level")
  text          String               @db.Text
  textTsv       Unsupported("tsvector")?    @map("text_tsv")
  embedding     Unsupported("vector(1536)")?
  metadata      Json?
  status        GuidelineChunkStatus @default(pending_review)
  institutionId String?              @map("institution_id") @db.Uuid
  reviewedBy    String?              @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?            @map("reviewed_at")
  validFrom     DateTime             @default(now()) @map("valid_from")
  validTo       DateTime?            @map("valid_to")
  createdAt     DateTime             @default(now()) @map("created_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([source, sourceVersion])
  @@index([specialty])
  @@index([status])
  @@index([institutionId])
  @@map("guideline_chunks")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id")
  action     String
  entity     String
  entityId   String   @map("entity_id")
  beforeHash String?  @map("before_hash") @db.Char(64)
  afterHash  String?  @map("after_hash") @db.Char(64)
  payload    Json?
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

model Consent {
  id          String    @id @default(uuid()) @db.Uuid
  physicianId String    @map("physician_id") @db.Uuid
  scope       String
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")

  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([physicianId])
  @@map("consents")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  physicianId String   @map("physician_id") @db.Uuid
  tokenHash   String   @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime @map("expires_at")
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([physicianId])
  @@map("refresh_tokens")
}

model MfaBackupCode {
  id          String    @id @default(uuid()) @db.Uuid
  physicianId String    @map("physician_id") @db.Uuid
  codeHash    String    @map("code_hash") @db.Char(64)
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([physicianId])
  @@map("mfa_backup_codes")
}

enum AudioCaptureStatus {
  pending
  transcribing
  completed
  failed
  deleted
}

model AudioCapture {
  id               String              @id @default(uuid()) @db.Uuid
  encounterId      String              @map("encounter_id") @db.Uuid
  physicianId      String              @map("physician_id") @db.Uuid
  encryptedContent String              @map("encrypted_content") @db.Text
  mimeType         String              @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                 @map("size_bytes")
  status           AudioCaptureStatus  @default(pending)
  jobId            String?             @map("job_id") @db.VarChar(255)
  transcribedText  String?             @map("transcribed_text") @db.Text
  retainUntil      DateTime            @map("retain_until")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([physicianId])
  @@index([retainUntil])
  @@map("audio_captures")
}

model Protocol {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  specialty     String
  version       Int            @default(1)
  status        ProtocolStatus @default(draft)
  institutionId String?        @map("institution_id") @db.Uuid
  sourceRef     String?        @map("source_ref")
  createdBy     String         @map("created_by") @db.Uuid
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  nodes       ProtocolNode[]
  runs        ProtocolRun[]

  @@index([name, specialty, institutionId])
  @@index([status])
  @@map("protocols")
}

model ProtocolNode {
  id         String           @id @default(uuid()) @db.Uuid
  protocolId String           @map("protocol_id") @db.Uuid
  nodeType   ProtocolNodeType @map("node_type")
  content    Json
  order      Int
  createdAt  DateTime         @default(now()) @map("created_at")

  protocol      Protocol       @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  outgoingEdges ProtocolEdge[] @relation("ProtocolEdgeFrom")
  incomingEdges ProtocolEdge[] @relation("ProtocolEdgeTo")

  @@index([protocolId])
  @@map("protocol_nodes")
}

model ProtocolEdge {
  id         String   @id @default(uuid()) @db.Uuid
  fromNodeId String   @map("from_node_id") @db.Uuid
  toNodeId   String   @map("to_node_id") @db.Uuid
  condition  Json?
  createdAt  DateTime @default(now()) @map("created_at")

  fromNode ProtocolNode @relation("ProtocolEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   ProtocolNode @relation("ProtocolEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("protocol_edges")
}

enum ProtocolRunStatus {
  in_progress
  completed
  abandoned
}

model ProtocolRun {
  id              String            @id @default(uuid()) @db.Uuid
  encounterId     String            @map("encounter_id") @db.Uuid
  protocolId      String            @map("protocol_id") @db.Uuid
  protocolVersion Int               @map("protocol_version")
  currentNodeId   String            @map("current_node_id") @db.Uuid
  status          ProtocolRunStatus @default(in_progress)
  answers         Json?
  abandonReason   String?           @map("abandon_reason")
  startedBy       String            @map("started_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  protocol  Protocol  @relation(fields: [protocolId], references: [id])

  @@index([encounterId])
  @@index([protocolId])
  @@map("protocol_runs")
}

model CrmVerificationRequest {
  id          String                @id @default(uuid()) @db.Uuid
  physicianId String                @map("physician_id") @db.Uuid
  status      CrmVerificationStatus @default(PENDING)
  notes       String?               @db.Text
  resolvedBy  String?               @map("resolved_by") @db.VarChar(255)
  resolvedAt  DateTime?             @map("resolved_at")
  requestedAt DateTime              @default(now()) @map("requested_at")

  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([physicianId])
  @@index([status])
  @@map("crm_verification_requests")
}
