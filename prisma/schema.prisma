  physicianId String    @map("physician_id") @db.Uuid
  scope       String
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")

  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([physicianId])
  @@map("consents")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  physicianId String   @map("physician_id") @db.Uuid
  tokenHash   String   @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime @map("expires_at")
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([physicianId])
  @@map("refresh_tokens")
}

model MfaBackupCode {
  id          String    @id @default(uuid()) @db.Uuid
  physicianId String    @map("physician_id") @db.Uuid
  codeHash    String    @map("code_hash") @db.Char(64)
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([physicianId])
  @@map("mfa_backup_codes")
}

enum AudioCaptureStatus {
  pending
  transcribing
  completed
  failed
  deleted
}

model AudioCapture {
  id               String             @id @default(uuid()) @db.Uuid
  encounterId      String             @map("encounter_id") @db.Uuid
  physicianId      String             @map("physician_id") @db.Uuid
  encryptedContent String             @map("encrypted_content") @db.Text
  mimeType         String             @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                @map("size_bytes")
  status           AudioCaptureStatus @default(pending)
  jobId            String?            @map("job_id") @db.VarChar(255)
  transcribedText  String?            @map("transcribed_text") @db.Text
  retainUntil      DateTime           @map("retain_until")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([physicianId])
  @@index([retainUntil])
  @@map("audio_captures")
}

model Protocol {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  specialty     String
  version       Int            @default(1)
  status        ProtocolStatus @default(draft)
  institutionId String?        @map("institution_id") @db.Uuid
  sourceRef     String?        @map("source_ref")
  createdBy     String         @map("created_by") @db.Uuid
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  institution Institution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  nodes       ProtocolNode[]
  runs        ProtocolRun[]

  @@index([name, specialty, institutionId])
  @@index([status])
  @@map("protocols")
}

model ProtocolNode {
  id         String           @id @default(uuid()) @db.Uuid
  protocolId String           @map("protocol_id") @db.Uuid
  nodeType   ProtocolNodeType @map("node_type")
  content    Json
  order      Int
  createdAt  DateTime         @default(now()) @map("created_at")

  protocol      Protocol       @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  outgoingEdges ProtocolEdge[] @relation("ProtocolEdgeFrom")
  incomingEdges ProtocolEdge[] @relation("ProtocolEdgeTo")

  @@index([protocolId])
  @@map("protocol_nodes")
}

model ProtocolEdge {
  id         String   @id @default(uuid()) @db.Uuid
  fromNodeId String   @map("from_node_id") @db.Uuid
  toNodeId   String   @map("to_node_id") @db.Uuid
  condition  Json?
  createdAt  DateTime @default(now()) @map("created_at")

  fromNode ProtocolNode @relation("ProtocolEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   ProtocolNode @relation("ProtocolEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("protocol_edges")
}

enum ProtocolRunStatus {
  in_progress
  completed
  abandoned
}

model ProtocolRun {
  id              String            @id @default(uuid()) @db.Uuid
  encounterId     String            @map("encounter_id") @db.Uuid
  protocolId      String            @map("protocol_id") @db.Uuid
  protocolVersion Int               @map("protocol_version")
  currentNodeId   String            @map("current_node_id") @db.Uuid
  status          ProtocolRunStatus @default(in_progress)
  answers         Json?
  abandonReason   String?           @map("abandon_reason")
  startedBy       String            @map("started_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  protocol  Protocol  @relation(fields: [protocolId], references: [id])

  @@index([encounterId])
  @@index([protocolId])
  @@map("protocol_runs")
}

model CrmVerificationRequest {
  id          String                @id @default(uuid()) @db.Uuid
  physicianId String                @map("physician_id") @db.Uuid
  status      CrmVerificationStatus @default(PENDING)
  notes       String?               @db.Text
  resolvedBy  String?               @map("resolved_by") @db.VarChar(255)
  resolvedAt  DateTime?             @map("resolved_at")
  requestedAt DateTime              @default(now()) @map("requested_at")

  physician Physician @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([physicianId])
  @@index([status])
  @@map("crm_verification_requests")
}
