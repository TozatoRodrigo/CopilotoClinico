# Application
PORT=3000
NODE_ENV=development
API_PREFIX=v1
CORS_ORIGIN=http://localhost:3001

# Database
# DATABASE_URL deve ser a role de runtime da aplicacao, sem privilegios de DDL.
DATABASE_URL=postgresql://copiloto_app_user:copiloto_app_dev@localhost:5432/copiloto_clinico?schema=public
# MIGRATION_DATABASE_URL deve ser usada apenas por prisma migrate deploy/dev.
MIGRATION_DATABASE_URL=postgresql://copiloto_owner:copiloto_owner_dev@localhost:5432/copiloto_clinico?schema=public
POSTGRES_OWNER_USER=copiloto_owner
POSTGRES_OWNER_PASSWORD=copiloto_owner_dev
POSTGRES_APP_USER=copiloto_app_user
POSTGRES_APP_PASSWORD=copiloto_app_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_SECRET=your-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=copiloto_minio_key
MINIO_SECRET_KEY=copiloto_minio_secret_change_me
MINIO_BUCKET=copiloto-clinico
MINIO_USE_SSL=false

# AI Gateway
AI_PROVIDER=anthropic
AI_API_KEY=your-api-key-here
AI_MODEL=claude-sonnet-4-20250514
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Whisper
WHISPER_PROVIDER=groq
WHISPER_API_KEY=your-whisper-key-here
WHISPER_BASE_URL=https://api.groq.com/openai/v1

# Sentry
SENTRY_DSN=

# Logging
LOG_LEVEL=debug

# Internal Service Communication
# Token compartilhado para endpoints internos (ex: POST /audit/verify-chain).
# Gerar com: openssl rand -hex 32
# Nunca expor publicamente — usar em conjunto com regras de rede/firewall.
INTERNAL_SERVICE_TOKEN=change-me-internal-token-min-32-chars!!
