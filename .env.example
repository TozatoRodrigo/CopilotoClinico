# Application
PORT=3000
NODE_ENV=development
API_PREFIX=v1
CORS_ORIGIN=http://localhost:3001

# Database
DATABASE_URL=postgresql://copiloto:copiloto_dev@localhost:5432/copiloto_clinico?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=copiloto_minio_key
MINIO_SECRET_KEY=copiloto_minio_secret_change_me
MINIO_BUCKET=copiloto-clinico
MINIO_USE_SSL=false

# AI Gateway
AI_PROVIDER=anthropic
AI_API_KEY=your-api-key-here
AI_MODEL=claude-sonnet-4-20250514
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_BASE_URL=https://api.anthropic.com

# Whisper
WHISPER_PROVIDER=groq
WHISPER_API_KEY=your-whisper-key-here
WHISPER_BASE_URL=https://api.groq.com/openai/v1

# Sentry
SENTRY_DSN=

# Logging
LOG_LEVEL=debug
