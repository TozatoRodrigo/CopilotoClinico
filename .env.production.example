# Public hosts served by Traefik
WEB_HOST=copiloto.example.com
API_HOST=api-copiloto.example.com

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=v1
CORS_ORIGIN=https://copiloto.example.com
LOG_LEVEL=info

# Database
POSTGRES_DB=copiloto_clinico
POSTGRES_USER=copiloto
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://copiloto:replace-with-strong-password@postgres:5432/copiloto_clinico?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT cookies
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace-with-minio-root-user
MINIO_SECRET_KEY=replace-with-strong-minio-password
MINIO_BUCKET=copiloto-clinico
MINIO_USE_SSL=false

# AI Gateway - MVP uses OpenAI for completion and embeddings
AI_PROVIDER=openai
AI_API_KEY=
OPENAI_API_KEY=replace-with-openai-api-key
AI_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_BASE_URL=https://api.openai.com

# Observability
SENTRY_DSN=
