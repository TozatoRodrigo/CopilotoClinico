# ── Dockerfile API (NestJS backend) ──────────────────────────────────────────
# Build independente do frontend. Usa node:22-alpine (compatível com VPS x86_64).
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

# Instala deps do backend, inclusive as de desenvolvimento (build e scripts)
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma/
RUN pnpm install --frozen-lockfile --prod=false

# Build do backend. O runbook também usa este estágio (`--target builder`) para
# a ingestão e o sync da base oficial, que precisam de scripts/, src/ e tsx.
FROM deps AS builder
COPY . .
RUN npx prisma generate
RUN npx nest build

# Só as dependências de produção, mais o CLI do Prisma: as migrations rodam
# dentro da imagem final (`npx --no-install prisma migrate deploy`, runbook).
FROM base AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma/
# O `prisma` é devDependency, mas o lock também o instala como dependência
# opcional do @prisma/client. O public-hoist-pattern o liga em
# node_modules/prisma e node_modules/.bin/prisma sem mexer no lock.
RUN pnpm install --frozen-lockfile --prod --config.public-hoist-pattern=prisma
# Gera o cliente neste node_modules e, de quebra, derruba o build se o CLI não
# estiver ligado, em vez de a falta aparecer só na hora da migration.
RUN npx --no-install prisma generate

# Runtime mínimo
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache tini

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/package.json ./package.json

EXPOSE 3000
CMD ["tini", "--", "node", "dist/main.js"]
