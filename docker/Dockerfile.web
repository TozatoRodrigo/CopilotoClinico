# ── Dockerfile Web (Next.js frontend) ────────────────────────────────────────
# Build com NEXT_PUBLIC_API_URL=/v1 (path relativo — Traefik roteia /v1/* ao API).
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

# Instala deps do frontend
FROM base AS deps
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Build do frontend
FROM deps AS builder
COPY web/ ./
# NEXT_PUBLIC_API_URL=/v1 faz o browser chamar a mesma origem (/v1/auth/login etc).
# Traefik roteia /v1/* → copiloto-api e /* → copiloto-web.
ENV NEXT_PUBLIC_API_URL=/v1
# Analytics — Umami autoalojado (analytics.servidortozato.cloud), site
# "Copiloto Clínico" cadastrado manualmente no banco do Umami (ver
# apps/umami/docker-compose.yml na VPS). Só presente aqui, na imagem de
# produção — build local/CI/e2e não define isso, então o script nem
# renderiza (ver web/src/app/layout.tsx).
ENV NEXT_PUBLIC_UMAMI_WEBSITE_ID=ddd2c36c-bcc0-47b0-8288-2d3bbebfa954
ENV NEXT_PUBLIC_UMAMI_SRC=https://analytics.servidortozato.cloud/script.js
RUN pnpm build

# Runtime
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
RUN apk add --no-cache tini

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000
CMD ["tini", "--", "node", "server.js"]
